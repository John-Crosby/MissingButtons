<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AudioComponents</key>
	<array>
		<dict>
			<key>description</key>
			<string>@MB_NAME@</string>
			<key>factoryFunction</key>
			<string>@MB_AU_FACTORY@</string>
			<key>manufacturer</key>
			<string>@MB_MFR_ID@</string>
			<key>name</key>
			<string>@MB_MFR@: @MB_NAME@</string>
			<key>sandboxSafe</key>
			<true/>
			<key>subtype</key>
			<string>@MB_UNIQUE_ID@</string>
			<key>type</key>
			<string>aufx</string>
			<key>version</key>
			<integer>@MB_VERSION_INT@</integer>
		</dict>
	</array>
	<key>AudioUnit Version</key>
	<string>@MB_VERSION_HEX@</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>@MB_BUNDLE_NAME@</string>
	<key>CFBundleGetInfoString</key>
	<string>@MB_NAME@ v@MB_VERSION_STR@ @MB_COPYRIGHT@</string>
	<key>CFBundleIdentifier</key>
	<string>@MB_AU_BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@MB_BUNDLE_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>BNDL</string>
	<key>CFBundleShortVersionString</key>
	<string>@MB_VERSION_STR@</string>
	<key>CFBundleSignature</key>
	<string>@MB_UNIQUE_ID@</string>
	<key>CFBundleVersion</key>
	<string>@MB_VERSION_STR@</string>
	<key>CSResourcesFileMapped</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>@MB_MIN_MACOS@</string>
	<key>NSPrincipalClass</key>
	<string>@MB_AU_VIEW@</string>
</dict>
</plist>
